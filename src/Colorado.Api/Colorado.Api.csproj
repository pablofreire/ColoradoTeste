<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net6.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <!-- Gera o XML para o Swagger sem exigir doc em todo membro publico -->
    <NoWarn>$(NoWarn);1591</NoWarn>
    <UserSecretsId>colorado-api-6f2b8c1e-4d3a-4f7e-9b5c-2a1d0e8f7c34</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Swashbuckle.AspNetCore" Version="6.5.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Colorado.Aplicacao\Colorado.Aplicacao.csproj" />
    <ProjectReference Include="..\Colorado.Infraestrutura\Colorado.Infraestrutura.csproj" />
  </ItemGroup>

</Project>
