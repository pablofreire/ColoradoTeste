@{
    ViewData["Title"] = "Clientes";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="h4 mb-0">Clientes</h1>
    <button type="button" class="btn btn-primary" id="idClienteNovo">
        <i class="bi bi-plus-lg"></i> Novo cliente
    </button>
</div>

<div class="card mb-3">
    <div class="card-body">
        <div class="row g-2 align-items-end">
            <div class="col-md-5">
                <label class="form-label" for="idClienteFiltroNome">Nome / Razao social</label>
                <input type="text" class="form-control" id="idClienteFiltroNome" placeholder="Buscar por nome" />
            </div>
            <div class="col-md-4">
                <label class="form-label" for="idClienteFiltroDocumento">Documento</label>
                <input type="text" class="form-control" id="idClienteFiltroDocumento" placeholder="CPF ou CNPJ" />
            </div>
            <div class="col-md-3 d-flex gap-2">
                <button class="btn btn-primary flex-grow-1" id="idClientePesquisar">Pesquisar</button>
                <button class="btn btn-outline-secondary" id="idClienteLimpar">Limpar</button>
            </div>
        </div>
    </div>
</div>

<div id="containerTabela"></div>
<div id="containerModal"></div>

@section Scripts {
    <script src="~/js/Cliente/cliente.js" asp-append-version="true"></script>
    <script>document.addEventListener('DOMContentLoaded', clienteInicializar);</script>
}
