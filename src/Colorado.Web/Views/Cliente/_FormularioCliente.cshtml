@model SalvarClienteViewModel

@functions {
    string OpcoesTipo(int? selecionado)
    {
        var html = new System.Text.StringBuilder();
        foreach (var t in Model.TiposDisponiveis)
        {
            var sel = selecionado == t.Codigo ? " selected" : "";
            html.Append($"<option value=\"{t.Codigo}\"{sel}>{t.Descricao}</option>");
        }
        return html.ToString();
    }
}

<div class="modal fade" id="idClienteModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-scrollable">
        <div class="modal-content">
            <form id="idClienteForm">
                <div class="modal-header">
                    <h5 class="modal-title">@(Model.EhEdicao ? "Editar cliente" : "Novo cliente")</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Fechar"></button>
                </div>
                <div class="modal-body">
                    <div id="idClienteErros" class="alert alert-danger py-2 small d-none"></div>

                    <input type="hidden" asp-for="Codigo" />

                    <div class="row g-2">
                        <div class="col-md-3">
                            <label class="form-label" asp-for="TipoPessoa">Tipo de pessoa</label>
                            @if (Model.EhEdicao)
                            {
                                <select class="form-select" asp-for="TipoPessoa" disabled>
                                    <option value="J">Juridica</option>
                                    <option value="F">Fisica</option>
                                </select>
                                @* select disabled nao posta; o hidden mantem o valor no submit *@
                                <input type="hidden" name="TipoPessoa" value="@Model.TipoPessoa" />
                            }
                            else
                            {
                                <select class="form-select" asp-for="TipoPessoa">
                                    <option value="J">Juridica</option>
                                    <option value="F">Fisica</option>
                                </select>
                            }
                        </div>
                        <div class="col-md-9" id="colRazaoSocial">
                            <label class="form-label" id="lblRazaoSocial" asp-for="RazaoSocial">Razao social</label>
                            <input class="form-control" asp-for="RazaoSocial" maxlength="200" />
                        </div>
                        <div class="col-md-7" id="colNomeFantasia">
                            <label class="form-label" id="lblNomeFantasia" asp-for="NomeFantasia">Nome fantasia</label>
                            <input class="form-control" asp-for="NomeFantasia" maxlength="200" />
                        </div>
                        <div class="col-md-5">
                            <label class="form-label" id="lblDocumento" asp-for="Documento">Documento</label>
                            <input class="form-control" asp-for="Documento" maxlength="20" />
                        </div>
                        <div class="col-md-4">
                            <label class="form-label" asp-for="Cep">CEP</label>
                            <input class="form-control" asp-for="Cep" maxlength="9" inputmode="numeric" />
                        </div>

                        <div class="col-md-8">
                            <label class="form-label" asp-for="Endereco">Endereco</label>
                            <input class="form-control" asp-for="Endereco" maxlength="200" />
                        </div>
                        <div class="col-md-4">
                            <label class="form-label" asp-for="Complemento">Complemento</label>
                            <input class="form-control" asp-for="Complemento" maxlength="100" />
                        </div>
                        <div class="col-md-5">
                            <label class="form-label" asp-for="Bairro">Bairro</label>
                            <input class="form-control" asp-for="Bairro" maxlength="100" />
                        </div>
                        <div class="col-md-5">
                            <label class="form-label" asp-for="Cidade">Cidade</label>
                            <input class="form-control" asp-for="Cidade" maxlength="100" />
                        </div>
                        <div class="col-md-2">
                            <label class="form-label" asp-for="Uf">UF</label>
                            <select class="form-select" asp-for="Uf">
                                <option value="">UF</option>
                                @foreach (var uf in new[] { "AC", "AL", "AP", "AM", "BA", "CE", "DF", "ES", "GO", "MA", "MT", "MS", "MG", "PA", "PB", "PR", "PE", "PI", "RJ", "RN", "RS", "RO", "RR", "SC", "SP", "SE", "TO" })
                                {
                                    <option value="@uf">@uf</option>
                                }
                            </select>
                        </div>
                        @if (Model.EhEdicao)
                        {
                            <div class="col-md-4">
                                <label class="form-label">Usuario que cadastrou</label>
                                <input class="form-control" value="@Model.Usuario" readonly disabled />
                            </div>
                        }
                        else
                        {
                            <div class="col-md-4">
                                <label class="form-label" asp-for="Usuario">Usuario</label>
                                <input class="form-control" asp-for="Usuario" maxlength="50" placeholder="Quem esta cadastrando" />
                            </div>
                        }
                    </div>

                    <hr class="my-3" />

                    <div class="d-flex justify-content-between align-items-center mb-2">
                        <h6 class="mb-0">Telefones</h6>
                        <button type="button" class="btn btn-sm btn-outline-primary" id="idTelefoneAdicionar">Adicionar telefone</button>
                    </div>

                    <table class="table table-sm align-middle mb-0">
                        <thead>
                            <tr>
                                <th>Numero</th>
                                <th style="width: 30%;">Tipo</th>
                                <th>Operadora</th>
                                <th style="width: 1%;"></th>
                            </tr>
                        </thead>
                        <tbody id="idTelefoneLinhas">
                            @for (var i = 0; i < Model.Telefones.Count; i++)
                            {
                                var tel = Model.Telefones[i];
                                <tr>
                                    <input type="hidden" name="Telefones.Index" value="@i" />
                                    <input type="hidden" name="Telefones[@i].Ativo" value="true" />
                                    <td><input class="form-control form-control-sm" name="Telefones[@i].NumeroTelefone" value="@tel.NumeroTelefone" maxlength="20" /></td>
                                    <td><select class="form-select form-select-sm" name="Telefones[@i].CodigoTipoTelefone">@Html.Raw(OpcoesTipo(tel.CodigoTipoTelefone))</select></td>
                                    <td><input class="form-control form-control-sm" name="Telefones[@i].Operadora" value="@tel.Operadora" maxlength="50" /></td>
                                    <td><button type="button" class="btn btn-sm btn-outline-danger" data-remover-telefone>&times;</button></td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancelar</button>
                    <button type="submit" class="btn btn-primary" id="idClienteSalvar">Salvar</button>
                </div>
            </form>
        </div>
    </div>
</div>

<template id="idTelefoneTemplate">
    <tr>
        <input type="hidden" name="Telefones.Index" value="__key__" />
        <input type="hidden" name="Telefones[__key__].Ativo" value="true" />
        <td><input class="form-control form-control-sm" name="Telefones[__key__].NumeroTelefone" maxlength="20" inputmode="numeric" /></td>
        <td><select class="form-select form-select-sm" name="Telefones[__key__].CodigoTipoTelefone">@Html.Raw(OpcoesTipo(null))</select></td>
        <td><input class="form-control form-control-sm" name="Telefones[__key__].Operadora" maxlength="50" /></td>
        <td><button type="button" class="btn btn-sm btn-outline-danger" data-remover-telefone>&times;</button></td>
    </tr>
</template>
