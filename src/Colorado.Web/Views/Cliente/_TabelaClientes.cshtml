@model ClienteListaViewModel

<div class="card">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
                <tr>
                    <th style="width: 80px;">Codigo</th>
                    <th>Razao social</th>
                    <th>Nome fantasia</th>
                    <th style="width: 80px;">Tipo</th>
                    <th>Documento</th>
                    <th>Cidade/UF</th>
                    <th class="tabela-acoes text-end">Acoes</th>
                </tr>
            </thead>
            <tbody>
                @if (!Model.Itens.Any())
                {
                    <tr><td colspan="7" class="text-center text-muted py-4">Nenhum cliente encontrado.</td></tr>
                }
                else
                {
                    foreach (var cliente in Model.Itens)
                    {
                        <tr>
                            <td>@cliente.Codigo</td>
                            <td>@cliente.RazaoSocial</td>
                            <td>@cliente.NomeFantasia</td>
                            <td>@cliente.TipoPessoaDescricao</td>
                            <td>@cliente.Documento</td>
                            <td>@cliente.CidadeUf</td>
                            <td class="tabela-acoes text-end">
                                <button class="btn btn-sm btn-outline-secondary" data-acao="editar" data-codigo="@cliente.Codigo">Editar</button>
                                <button class="btn btn-sm btn-outline-danger" data-acao="excluir" data-codigo="@cliente.Codigo">Excluir</button>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
    <div class="card-footer d-flex justify-content-between align-items-center">
        <small class="text-muted">
            Pagina @Model.Pagina de @(Model.TotalPaginas == 0 ? 1 : Model.TotalPaginas) - @Model.TotalRegistros registro(s)
        </small>
        <div class="btn-group">
            <button class="btn btn-sm btn-outline-secondary" data-pagina="@(Model.Pagina - 1)"
                    disabled="@(Model.Pagina <= 1)">Anterior</button>
            <button class="btn btn-sm btn-outline-secondary" data-pagina="@(Model.Pagina + 1)"
                    disabled="@(Model.Pagina >= Model.TotalPaginas)">Proxima</button>
        </div>
    </div>
</div>
