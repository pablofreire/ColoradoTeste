@model TipoTelefoneListaViewModel

<div class="card">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
                <tr>
                    <th style="width: 90px;">Codigo</th>
                    <th>Descricao</th>
                    <th class="tabela-acoes text-end">Acoes</th>
                </tr>
            </thead>
            <tbody>
                @if (!Model.Itens.Any())
                {
                    <tr><td colspan="3" class="text-center text-muted py-4">Nenhum tipo cadastrado.</td></tr>
                }
                else
                {
                    foreach (var tipo in Model.Itens)
                    {
                        <tr>
                            <td>@tipo.Codigo</td>
                            <td>@tipo.Descricao</td>
                            <td class="tabela-acoes text-end">
                                <button class="btn btn-sm btn-outline-secondary" data-acao="editar" data-codigo="@tipo.Codigo">Editar</button>
                                <button class="btn btn-sm btn-outline-danger" data-acao="excluir" data-codigo="@tipo.Codigo">Excluir</button>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</div>
